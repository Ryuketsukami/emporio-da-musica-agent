LLM_API_KEY=            # Anthropic API key; used when LLM_DEV=false
LLM_MODEL=claude-sonnet-5
LLM_DEV=false           # true = route model calls through the local `claude` CLI (subscription)
LLM_DEV_MODEL=sonnet
LLM_JUDGE=false         # true = also label finished sessions with an LLM judge
LLM_JUDGE_MODEL=claude-haiku-4-5
LLM_DEV_JUDGE_MODEL=haiku
